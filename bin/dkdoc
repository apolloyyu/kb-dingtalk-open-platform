#!/usr/bin/env python3
"""dkdoc — 钉钉开放平台知识库查询 CLI（零依赖，cwd 无关，可通过软链调用）。

子命令:
  ctx   <词>...        ★一次打包检索：安全时 API 答案卡直答，否则正文+links+审计
  ctx --full <词>...  强制旧版全文路径（跳过答案卡，用于深查/回退）
  card  <doc_id|标题|endpoint>  打印 API 答案卡（full 可直答，partial 继续读原文）
  find  <词>...        按标题/面包屑/小标题/摘要找文档（多词=AND）
  api   <词|url片段>   查接口表（名称/endpoint/method/权限点/新旧版本）
  err   <错误码|词>    查错误码表（新版字符串码；旧版数字码会提示走 grep 兜底）
  event <事件名|词>    查事件表（按 EventType 标识或标题）
  jsapi <调用名|词>    查客户端 JSAPI（如 dd.setNavigationBar；专页优先，归档标注）
  perm  <权限点|词>    查权限点覆盖的接口
  links <路径|slug>    一篇文档的正链（它引用谁）与反链（谁引用它）
  cat   <路径|slug>    打印文档正文（含 source_url 头）
  grep  <pattern> [子路径]  全文检索兜底（优先 rg，无 rg 退化为 python 扫描）
  where                打印知识库根目录绝对路径

通用选项: -n N 每类结果上限（默认 10）
提示: 结果里的 docs/... 路径都相对知识库根；引用给用户时用 source_url。
"""
import json
import os
import re
import subprocess
import sys
from urllib.parse import urlsplit

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # realpath 兼容软链安装


def load_jsonl(rel):
    p = os.path.join(ROOT, rel)
    with open(p, encoding="utf-8") as f:
        return [json.loads(line) for line in f]


def api_card_index():
    p = os.path.join(ROOT, "cards", "api-index.jsonl")
    return load_jsonl("cards/api-index.jsonl") if os.path.exists(p) else []


def read_api_card(doc_path):
    hit = next((r for r in api_card_index() if r.get("doc_path") == doc_path), None)
    if not hit:
        return None
    p = os.path.join(ROOT, hit["path"])
    if not os.path.exists(p):
        return None
    body = open(p, encoding="utf-8", errors="replace").read()
    return {**hit, "body": body.rstrip(),
            "full": hit.get("completeness") == "full" and "\ncompleteness: full\n" in "\n" + body}


_INTENT_LABELS = {
    "why": "因果/机制",
    "howmany": "数值/限额",
    "support": "支持性判断",
    "error": "报错归因",
    "version": "版本/归档",
    "cross_doc": "跨文档汇总",
    "semantic": "条件/流程",
    "ui": "客户端展示行为",
    "stage": "跨配置阶段数据流",
    "id_format": "ID格式/合法性",
    "lifecycle": "生命周期/触发时机",
    "enumeration": "枚举/全量列表",
    "truncated": "输入疑似截断",
}


def _evidence_contract(card=None, intent=None, fast=False):
    """检索输出的事实边界；不改官方正文，也不把示例外观升级为格式约束。"""
    intent = intent or {}
    blocked = [_INTENT_LABELS[k] for k, v in intent.items() if v and k in _INTENT_LABELS]
    if card and fast:
        title = card.get("title") or card.get("doc_id") or "当前 API"
        lines = [f"mode: card-only · card: {title}"]
    elif card:
        lines = ["mode: full-context-required · card-only: disabled;以展开正文为证据"]
    else:
        lines = ["mode: full-context-required · card: none"]
    if blocked:
        lines.append("blocked_by: " + ", ".join(blocked))
    lines += [
        "scope: 结论只在当前 source_url 明示的 API、端、阶段、应用类型和版本内有效",
        "proves: 卡片仅证明列出的 method/endpoint/应用类型/权限/请求头/路径、查询和Body参数/响应字段/必填性/明确限额；正文仅证明其逐字陈述",
        "not_proved: 未明示的 ID 格式或校验、其他接口/配置阶段的数据流、客户端分栏/排序/展示因果",
        "rule: 示例值不等于格式规范；字段存在不等于它决定产品行为；未直接证明则写“文档未说明”",
    ]
    return "== 证据契约 ==\n" + "\n".join(lines)


def cmd_card(terms, n):
    if not terms:
        return usage("card 需要 doc_id、API 标题、endpoint 或 doc_path")
    q = " ".join(terms).strip().lower()
    rows = []
    for r in api_card_index():
        vals = [str(r.get(k) or "").lower() for k in ("doc_id", "title", "endpoint", "doc_path")]
        if any(q == x for x in vals) or any(q in x for x in vals):
            exact = 0 if any(q == x for x in vals) else 1
            rows.append((exact, r.get("archived", False),
                         r.get("completeness") != "full", r["doc_id"], r))
    shown = 0
    unique_hit = len(rows) == 1
    for exact, *_, r in sorted(rows)[:n]:
        p = os.path.join(ROOT, r["path"])
        if not os.path.exists(p):
            continue
        if shown:
            print("\n---\n")
        body = open(p, encoding="utf-8", errors="replace").read()
        print(body.rstrip())
        # 模糊子串多命中说明查询没锚定到具体 API；此时卡片只是候选线索，
        # 不得声明 card-only 直答（实录：`card 用户` 命中一串无关接口全标可直答）。
        anchored = exact == 0 or unique_hit
        direct = (anchored and r.get("completeness") == "full" and not r.get("archived")
                  and "\ncompleteness: full\n" in "\n" + body)
        print("\n" + _evidence_contract(r, fast=direct))
        shown += 1
    if not shown:
        print(f"API 答案卡无命中: {q};用 dkdoc api/find 或 ctx --full 查原文")
        return 1
    return 0


_TERM_INDEX = None


def term_index():
    """graph/terms.json：正文 ASCII 标识符 → [[doc_idx, count]]（build_term_index.py 生成）。"""
    global _TERM_INDEX
    if _TERM_INDEX is None:
        p = os.path.join(ROOT, "graph", "terms.json")
        try:
            _TERM_INDEX = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else {}
        except ValueError:
            _TERM_INDEX = {}
    return _TERM_INDEX


def term_doc_hits(tl, docs):
    """查询里的 ASCII 标识符（字段名/JSAPI/错误码）在标题层常零命中，改查正文倒排索引。
    返回 {local_path: score}；命中越多篇的泛词权重越低，dd.xxx 形式退化为末段再查。"""
    idx = term_index()
    if not idx:
        return {}
    hits = {}
    for w in tl:
        if not re.fullmatch(r"[a-z][a-z0-9_.]{4,}", w):
            continue
        entry = idx.get(w) or idx.get(w.rsplit(".", 1)[-1])
        if not entry:
            continue
        df = len(entry)
        for rank, (di, cnt) in enumerate(entry):
            if 0 <= di < len(docs):
                lp = docs[di]["local_path"]
                hits[lp] = hits.get(lp, 0) + max(6, 40 - 4 * rank) + min(cnt, 10) - min(df, 10)
    return hits


def kb_flags():
    m = {}
    for r in load_jsonl("meta/kb_manifest.jsonl"):
        if r["tier"] == "T2" or r.get("deprecated"):
            m[r["local_path"]] = "⚠归档"
        elif r["tier"] == "DROP":
            m[r["local_path"]] = "◇边缘"
    return m


def resolve_doc(query, docs=None):
    """按 局部路径/slug/文件名/子串 唯一定位一篇文档；多命中则返回列表。"""
    docs = docs or load_jsonl("meta/documents.jsonl")
    q = query.strip().lstrip("./")
    exact = [d for d in docs if d["local_path"] == q or d["slug"] == q
             or os.path.basename(d["local_path"]) == os.path.basename(q)]
    if len(exact) == 1:
        return exact[0], None
    hits = exact or [d for d in docs if q.lower() in d["local_path"].lower()]
    if len(hits) == 1:
        return hits[0], None
    return None, hits


def _normalized_source_url(value):
    value = str(value or "").strip().rstrip(".,;，。；)]}】")
    if not value:
        return ""
    try:
        parsed = urlsplit(value)
    except ValueError:
        return ""
    if not parsed.scheme or not parsed.netloc:
        return ""
    return f"{parsed.scheme.lower()}://{parsed.netloc.lower()}{parsed.path.rstrip('/')}"


def _source_doc_hint(query, docs):
    """用户贴 source_url（即使带 query/fragment）时，确定性锚定对应文档。"""
    by_url = {_normalized_source_url(d.get("source_url")): d for d in docs if d.get("source_url")}
    by_slug = {str(d.get("slug") or "").lower(): d for d in docs if d.get("slug")}
    for raw in re.findall(r"https?://[^\s<>\"']+", query, re.I):
        normalized = _normalized_source_url(raw)
        if normalized in by_url:
            return by_url[normalized]
        try:
            slug = urlsplit(raw.rstrip(".,;，。；)]}】")).path.rstrip("/").rsplit("/", 1)[-1].lower()
        except ValueError:
            slug = ""
        if slug in by_slug:
            return by_slug[slug]
    return None


def print_doc_hit(d, flags, indent="  "):
    crumb = " › ".join(d.get("breadcrumb") or [])
    tag = " " + flags.get(d["local_path"], "") if flags.get(d["local_path"]) else ""
    print(d["local_path"] + tag)
    print(f"{indent}{d['title']} · {crumb} · {d['updated_at'][:10]}")
    print(f"{indent}{d['source_url']}")


def cmd_find(terms, n):
    if not terms:
        return usage("find 需要至少一个关键词")
    docs = load_jsonl("meta/documents.jsonl")
    flags = kb_flags()
    tl = [t.lower() for t in terms]
    scored = []
    for d in docs:
        title = d["title"].lower()
        crumb = " ".join(d.get("breadcrumb") or []).lower()
        rest = (" ".join(d.get("headings") or []) + " " + d.get("snippet", "") + " "
                + d.get("slug", "") + " " + os.path.basename(d["local_path"])).lower()
        hay = " ".join((title, crumb, rest))
        nhit = sum(1 for w in tl if w in hay)
        if nhit == 0:
            continue
        # AND 太严(自然问句拆词很难同时命中一篇),改为 OR + 命中词数优先
        score = nhit * 10 + sum(3 for w in tl if w in title) + sum(2 for w in tl if w in crumb)
        tier_rank = 1 if d["local_path"] in flags else 0
        scored.append((-score, tier_rank, d["local_path"], d))
    scored.sort()
    if not scored:
        print(f"目录/标题层无命中。兜底: dkdoc grep '{' '.join(terms)}'")
        return 1
    for _, _, _, d in scored[:n]:
        print_doc_hit(d, flags)
    if len(scored) > n:
        print(f"…共 {len(scored)} 条，-n 加大上限")
    return 0


def cmd_api(terms, n):
    tl = [t.lower() for t in terms]
    def _hay_api(r):
        return " ".join(str(r.get(k) or "") for k in ("title", "endpoint", "method")).lower()
    _api = load_jsonl("graph/api.jsonl")
    rows = [r for r in _api if all(w in _hay_api(r) for w in tl)]
    if not rows and len(tl) > 1:
        rows = sorted(_api, key=lambda r: -sum(1 for w in tl if w in _hay_api(r)))
        rows = [r for r in rows if any(w in _hay_api(r) for w in tl)]
    rows.sort(key=lambda r: (r.get("archived", False), r["title"]))
    for r in rows[:n]:
        tag = " ⚠归档" if r.get("archived") else ""
        perm = f" · 权限:{','.join(r.get('permission_scopes') or [])}" if r.get("permission_scopes") else ""
        print(f"{r['title']}{tag} · {(r.get('method') or '?')} {r.get('endpoint') or ''} · {r.get('api_version') or ''}{perm}")
        print(f"  {r['doc_path']}")
        print(f"  {r['source_url']}")
    if not rows:
        print(f"接口表无命中。试 dkdoc find {' '.join(terms)} 或 dkdoc grep")
        return 1
    if len(rows) > n:
        print(f"…共 {len(rows)} 条，-n 加大上限")
    return 0


def cmd_err(terms, n):
    q = terms[0] if terms else ""
    rows = load_jsonl("graph/errcode.jsonl")
    exact = [r for r in rows if r["error_code"].lower() == q.lower()]
    if not exact and q.isdigit():
        # 旧版数字错误码被抽取器错位进 http_code 字段(旧式表格套新式列映射),按该字段精确补捞
        exact = [r for r in rows if r.get("http_code") == q]
    hits = exact or [r for r in rows if all(
        t.lower() in (r["error_code"] + " " + r["message"] + " " + r.get("explanation", "")).lower() for t in terms)]
    for r in hits[:n]:
        print(f"{r['error_code']} · {r['message']} · HTTP {r['http_code']}")
        print(f"  {r.get('explanation','')}")
        print(f"  {r['source_url']}")
    if not hits:
        print(f"错误码表无命中（数字码等未抽全），自动全文兜底 dkdoc grep '{q}' :")
        return cmd_grep([q], n)
    if len(hits) > n:
        print(f"…共 {len(hits)} 条，-n 加大上限")
    return 0


def cmd_event(terms, n):
    tl = [t.lower() for t in terms]
    rows = []
    for r in load_jsonl("graph/event.jsonl"):
        hay = (r["title"] + " " + " ".join(r.get("event_types", []))).lower()
        if all(t in hay for t in tl):
            rows.append(r)
    for r in rows[:n]:
        tag = " ⚠归档" if r.get("archived") else ""
        print(f"{r['title']}{tag} · 事件: {', '.join(r.get('event_types', []))}")
        print(f"  {r['doc_path']}")
        print(f"  {r['source_url']}")
    if not rows:
        print(f"事件表无命中（178 篇事件文档无标识未入表），自动全文兜底 dkdoc grep '{terms[0]}' :")
        return cmd_grep([terms[0]], n)
    return 0


def cmd_jsapi(terms, n):
    tl = [t.lower() for t in terms]
    rows = []
    for r in load_jsonl("graph/jsapi.jsonl"):
        hay = (r["title"] + " " + " ".join(r.get("jsapi_names", []))).lower()
        if all(t in hay for t in tl):
            rows.append(r)
    # 专页优先：现行压归档，调用名少的（专属文档）压总览页
    rows.sort(key=lambda r: (r.get("archived", False), len(r.get("jsapi_names", [])), r["doc_path"]))
    for r in rows[:n]:
        tag = " ⚠归档" if r.get("archived") else ""
        names = [x for x in r.get("jsapi_names", []) if any(t in x.lower() for t in tl)] or r.get("jsapi_names", [])
        print(f"{r['title']}{tag} · 含: {', '.join(names[:4])}")
        print(f"  {r['doc_path']}")
        print(f"  {r['source_url']}")
    if not rows:
        print(f"JSAPI 表无命中（表只收正文含 dd.* 调用名的客户端JSAPI文档），自动全文兜底 dkdoc grep '{terms[0]}' :")
        return cmd_grep([terms[0]], n)
    if len(rows) > n:
        print(f"…共 {len(rows)} 篇，-n 加大上限")
    return 0


def cmd_perm(terms, n):
    q = terms[0] if terms else ""
    rows = load_jsonl("graph/permission.jsonl")
    hits = [r for r in rows if r["permission_scope"].lower() == q.lower()] or \
           [r for r in rows if q.lower() in r["permission_scope"].lower()]
    for r in hits[:n]:
        print(f"{r['permission_scope']} · 覆盖 {r['api_count']} 个接口")
        for a in r.get("current_apis", [])[:n]:
            print(f"  {a['title']} · {a.get('endpoint','')} · {a['doc_path']}")
    if not hits:
        if "." in q:
            prefix = q.rsplit(".", 1)[0].lower() + "."
            sib = [r for r in rows if r["permission_scope"].lower().startswith(prefix)]
            if sib:
                print(f"权限点 {q} 未收录；同前缀最接近的兄弟权限点（非精确命中，官方名以线上为准）：")
                for r in sib[:n]:
                    apis = r.get("current_apis") or []
                    hint = f" · 如 {apis[0]['title']} {apis[0]['doc_path']}" if apis else ""
                    print(f"  {r['permission_scope']} · 覆盖 {r['api_count']} 个接口{hint}")
        print(f"权限表无精确命中（表只收服务端 API 文档「权限要求」行，未必全），自动全文兜底 dkdoc grep '{q}' :")
        return cmd_grep([q], n)
    return 0


def cmd_links(terms, n):
    if not terms:
        return usage("links 需要一个 路径|slug")
    d, cands = resolve_doc(terms[0])
    if d is None:
        print("定位不唯一/无命中：")
        for c in (cands or [])[:10]:
            print("  " + c["local_path"])
        return 1
    lp = d["local_path"]
    edges = load_jsonl("graph/links.jsonl")
    out = [e for e in edges if e["from"] == lp]
    inc = [e for e in edges if e["to"] == lp]
    print(f"{lp}\n  {d['title']} · {d['source_url']}")
    print(f"\n正链（本篇引用 {len(out)} 篇）:")
    for e in out[:n]:
        print(f"  → {e['to']}（{e['text'][:30]}）")
    print(f"\n反链（{len(inc)} 篇引用本篇）:")
    for e in inc[:n]:
        print(f"  ← {e['from']}")
    if len(inc) > n or len(out) > n:
        print("…-n 加大上限")
    return 0


def cmd_cat(terms, n):
    if not terms:
        return usage("cat 需要一个 路径|slug")
    d, cands = resolve_doc(terms[0])
    if d is None:
        print("定位不唯一/无命中：")
        for c in (cands or [])[:10]:
            print("  " + c["local_path"])
        return 1
    sys.stdout.write(open(os.path.join(ROOT, d["local_path"]), encoding="utf-8").read())
    return 0


def cmd_grep(terms, n):
    if not terms:
        return usage("grep 需要 pattern")
    pattern, sub = terms[0], (terms[1] if len(terms) > 1 else "docs")
    try:
        r = subprocess.run(["rg", "-n", "--no-heading", "-m", "5", pattern, sub],
                           cwd=ROOT, capture_output=True, text=True)
        lines = r.stdout.splitlines()
        for line in lines[:max(n * 5, 50)]:
            print(line)
        if len(lines) > max(n * 5, 50):
            print(f"…共 {len(lines)} 行命中，收窄 pattern 或指定子路径")
        return 0 if lines else 1
    except FileNotFoundError:
        pat = re.compile(pattern)
        cnt = 0
        for dirpath, _, files in os.walk(os.path.join(ROOT, sub)):
            for fn in files:
                if not fn.endswith(".md"):
                    continue
                fp = os.path.join(dirpath, fn)
                for i, line in enumerate(open(fp, encoding="utf-8", errors="ignore"), 1):
                    if pat.search(line):
                        print(f"{os.path.relpath(fp, ROOT)}:{i}:{line.rstrip()[:200]}")
                        cnt += 1
                        if cnt >= max(n * 5, 50):
                            print("…已截断")
                            return 0
                        break
        return 0 if cnt else 1


def cmd_ctx(terms, n, force_full=False):
    """一次打包检索：安全时答案卡直答，否则正文+links；异常→CTX_ERROR。"""
    try:
        return _ctx_impl(terms, n, force_full=force_full)
    except SystemExit:
        raise
    except Exception as e:  # 绝不半吊子输出：报错即引导回退旧检索序
        print(f"CTX_ERROR: {type(e).__name__}: {e}；请改用分步命令(find/api/err/event/jsapi/perm→cat→links→grep)")
        return 1


_CTX_BODY_CAP = 6000     # 单篇正文上限(字符)；R10.2.2 由 8000 收紧,无实体命中的泛问不该比实体题更长
_CTX_TOTAL_CAP = 20000   # 总输出上限(字符)


def _looks_truncated_input(q):
    """保守识别未闭合代码/报文或只贴片段未提出问题；只用于禁止 card-only。"""
    s = q.strip()
    codeish = any(k in s.lower() for k in
                  ("{", "[", "```", "json", "curl", "payload", "request", "response",
                   "userid", "unionid", "access_token", "header", "body", "msg", "param"))
    if not codeish:
        return False
    if any(s.count(left) != s.count(right) for left, right in (("{", "}"), ("[", "]"), ("(", ")"))):
        return True
    if s.count('"') % 2 or s.count("`") % 2:
        return True
    if s.endswith((",", "，", ":", "：", "{", "[", "(", "\\", "...", "…")):
        return True
    question_signal = any(k in s.lower() for k in
                          ("?", "？", "吗", "呢", "为什么", "怎么", "如何", "是否", "能否", "请", "帮我", "报错", "错误"))
    structured_fragment = any(k in s for k in ("{", "[", "```", "\":", "'=", "=>", "="))
    return structured_fragment and not question_signal


def _intent(terms):
    """问法预判：决定答案卡能否独立覆盖；高风险题必须带正文与相邻篇。"""
    q = " ".join(terms).lower()
    support = (any(k in q for k in ("支持", "有没有", "有吗", "能不能", "可以吗", "是否", "会不会", "能否"))
               or bool(re.search(r"(?:能|可以).{0,3}(?:获取|查询|查看|拿到|做到|实现|解析|发送|创建|删除|使用|读取)", q)))
    has_id = "id" in q or any(k in q for k in ("标识", "实例号", "用户号", "会话号"))
    id_judgment = any(k in q for k in
                      ("格式", "合法", "有效", "无效", "正确", "长度", "前缀", "纯数字", "字符集", "uuid", "看起来像", "是不是"))
    return {
        "why":     any(k in q for k in ("为什么", "原理", "机制", "不一致", "冲突", "怎么回事", "原因", "逻辑", "源码", "导致", "因为什么")),
        "howmany": any(k in q for k in ("多少", "上限", "限制", "有效期", "时效", "时效性", "过期", "配额", "频率", "几个", "多久", "时长")),
        "support": support,
        "error":   (any(k in q for k in ("报错", "错误", "失败", "异常", "errcode", "不通过", "提示", "无权限", "param_error"))
                    or bool(re.search(r"\b(error|failed|exception|denied)\b", q))),
        "version": any(k in q for k in ("版本", "归档", "下线", "兼容", "灰度", "什么时候上线")),
        "cross_doc": any(k in q for k in ("全部接口", "所有接口", "有哪些接口", "哪些接口", "有哪些事件", "全部事件", "全量")),
        "semantic": (any(k in q for k in ("如果", "情况下", "先", "再", "然后", "之后", "只是", "还是", "区别", "影响",
                                              "如何在", "怎么在", "流程", "步骤", "怎么实现", "如何实现",
                                              "怎么开通", "如何开通", "怎么申请", "如何申请", "添加权限", "配置权限", "授权"))
                     # 「如何使用/怎么调用/怎样接入」是流程题，即使带 source_url 强锚点
                     # 也必须展开正文示例，不得 card-only（实录：贴 URL 问用法只回卡片字段）。
                     or bool(re.search(r"(?:怎么|如何|怎样)\s*(?:用|使用|调用|接入|集成|对接)", q))),
        "ui": any(k in q for k in ("客户端", "分栏", "tab", "排序", "置顶", "展示算法", "展示逻辑", "优先处理", "待我处理", "红点", "推荐")),
        "stage": any(k in q for k in ("鉴权阶段", "鉴权请求", "执行动作", "入参映射", "出入参配置", "自动注入", "运行时注入",
                                              "$.body", "$.header", "上文节点", "跨阶段")),
        "id_format": has_id and id_judgment,
        "lifecycle": any(k in q for k in ("生命周期", "触发时机", "触发顺序", "回调时机", "何时触发", "何时失效", "什么时候失效")),
        "enumeration": any(k in q for k in ("列出", "枚举", "有哪些", "哪些", "全部", "所有", "分别是什么", "支持以下", "事件列表", "生命周期函数",
                                                  "可选值", "取值范围", "枚举值", "有效值", "合法值", "都有什么")),
        "truncated": _looks_truncated_input(q),
    }


def _limit_lines(body, n=12):
    """抽正文里的限额/配额/时长相关行（数值类问法用）。"""
    pat = re.compile(r"(上限|最多|不超过|限制|有效期|配额|频率|QPS|次/|分钟|小时|天内|长度)")
    hits = [l.strip() for l in body.splitlines() if pat.search(l) and len(l.strip()) > 6]
    return hits[:n]


_QUERY_ALIASES = {"page": "页面", "pages": "页面", "event": "事件", "events": "事件",
                  "permission": "权限", "permissions": "权限", "user": "用户"}


def _tokenize_query(terms, corpus, stop):
    """自然中文按语料最长匹配，不产生跨边界伪词；常见英文概念补中文同义词。"""
    out = []
    for raw in terms:
        for token in re.findall(r"[a-zA-Z0-9_.:/-]+|[一-鿿]+", raw):
            low = token.lower()
            if low in stop:
                continue
            if re.fullmatch(r"[a-zA-Z0-9_.:/-]+", token):
                # JSON 标点、布尔值与 source_url 不是实体词；":" 曾导致每个 endpoint 都命中。
                if not re.search(r"[a-z0-9]", low):
                    continue
                if low in {"true", "false", "null", "none", "debug", "http", "https"}:
                    continue
                if low.startswith(("http://", "https://")):
                    continue
                out.append(_QUERY_ALIASES.get(low, low))
                continue
            covered = [False] * len(token)
            for word in sorted((x for x in stop if re.fullmatch(r"[一-鿿]+", x)),
                               key=len, reverse=True):
                start = 0
                while True:
                    i = token.find(word, start)
                    if i < 0:
                        break
                    covered[i:i + len(word)] = [True] * len(word)
                    start = i + 1
            i = 0
            while i < len(token):
                if covered[i]:
                    i += 1
                    continue
                end = i
                while end < len(token) and not covered[end]:
                    end += 1
                seg, p = token[i:end], 0
                while p < len(seg):
                    best = ""
                    for size in range(min(20, len(seg) - p), 1, -1):
                        cand = seg[p:p + size].lower()
                        if cand in corpus:
                            best = cand
                            break
                    if best:
                        out.append(best)
                        p += len(best)
                    else:
                        p += 1
                i = end
    return list(dict.fromkeys(out))


def _ctx_impl(terms, n, force_full=False):
    if not terms:
        return usage("ctx 需要至少一个关键词")
    raw_query = " ".join(terms)
    intent = _intent(terms)
    # 问法虚词不参与检索(用户自然问句里的"支持/多少/为什么"是意图信号,不是实体词)
    _STOP = {"支持", "有没有", "有吗", "能不能", "可以吗", "是否", "多少", "上限", "限制", "有效期",
             "配额", "几个", "多久", "时长", "为什么", "原理", "机制", "原因", "怎么回事",
             "报错", "错误", "失败", "异常", "不通过", "提示", "全部", "所有", "哪些", "哪个",
             "什么", "如果", "情况下", "先", "再", "然后", "之后", "钉钉", "的", "吗", "呢", "怎么", "如何"}
    docs = load_jsonl("meta/documents.jsonl")
    doc_hint = _source_doc_hint(raw_query, docs)
    corpus = "\n".join((d["title"] + " " + " ".join(d.get("breadcrumb") or []) + " "
                          + " ".join(d.get("headings") or [])).lower() for d in docs)
    tl = _tokenize_query(terms, corpus, _STOP)
    if not tl:
        tl = [w.lower() for w in terms if re.search(r"[a-zA-Z0-9一-鿿]", w)]
    if doc_hint:
        hint_terms = [str(doc_hint.get("title") or "").lower(), str(doc_hint.get("slug") or "").lower()]
        tl = list(dict.fromkeys([x for x in hint_terms + tl if x]))
    flags = kb_flags()
    bymap = {d["local_path"]: d for d in docs}

    # 1) 五张实体表（匹配逻辑与各子命令一致；此处只收集不打印）
    ent_lines, ent_paths, ent_counts = [], [], {}
    def _hay_api(r):
        return " ".join([str(r.get(k) or "") for k in
                         ("title", "endpoint", "method", "permission_raw", "source_url", "doc_path")]
                        + list(r.get("permission_scopes") or []) + list(r.get("breadcrumb") or [])).lower()
    _api = load_jsonl("graph/api.jsonl")
    api_weak = {"设置", "请求", "请求参数", "参数", "执行", "执行动作", "动作", "获取", "相关",
                "需要", "配置", "映射", "规则", "编写", "代码", "流程", "步骤", "信息", "应用", "用户"}
    api_terms = [w for w in tl if w not in api_weak]
    q_join = " ".join(api_terms)
    api_scored = []
    raw_q = raw_query.lower()
    hard_api_signal = any(k in raw_q for k in
                          ("api", "接口", "endpoint", "接口地址", "请求地址", "请求方式", "请求方法",
                           "权限点", "api.dingtalk.com", "oapi.dingtalk.com"))
    api_signal = hard_api_signal or "access_token" in raw_q
    guide_query = intent["stage"] or (intent["semantic"] and not hard_api_signal)
    if guide_query and not hard_api_signal:
        api_signal = False
    hint_path = doc_hint.get("local_path") if doc_hint else ""
    for r in _api:
        hinted = bool(hint_path and r.get("doc_path") == hint_path)
        if hint_path and not hinted:
            continue
        hay = _hay_api(r)
        hit = sum(1 for w in api_terms if w in hay)
        if not hit and not hinted:
            continue
        title, endpoint = r["title"].lower(), (r.get("endpoint") or "").lower()
        exact = bool(q_join and (q_join == title or q_join == endpoint))
        strong_single = any(
            w in hay and ((re.fullmatch(r"[一-鿿]+", w) and len(w) >= 4)
                          or (re.fullmatch(r"[a-z0-9_.:/-]+", w) and len(w) >= 6))
            for w in api_terms)
        # 指南/流程题不能因“请求参数/配置/获取”等泛词被 API 表抢走；source_url 精确锚点例外。
        if not (hinted or exact or api_signal or hit >= 2 or strong_single):
            continue
        score = hit * 10 + sum(4 for w in api_terms if w in title) + sum(3 for w in api_terms if w in endpoint)
        if any(w == title or w == endpoint for w in api_terms):
            score += 500
        if exact:
            score += 1000
        if hinted:
            score += 5000
        rr = dict(r)
        rr["_ctx_score"] = score
        api_scored.append((bool(r.get("archived")), -score, r["title"], r["doc_path"], rr))
    api_scored.sort()
    rows = [r for _, _, _, _, r in api_scored]
    ent_counts["api"] = len(rows)
    for r in rows[:6]:
        tag = " ⚠归档" if r.get("archived") else ""
        perm = f" · 权限:{','.join(r.get('permission_scopes') or [])}" if r.get("permission_scopes") else ""
        ent_lines.append(f"[api] {r['title']}{tag} · {(r.get('method') or '?')} {r.get('endpoint') or ''}{perm}\n      {r['doc_path']} · {r['source_url']}")
        ent_paths.append(r["doc_path"])
    # 自然句里嵌入的错误码/权限点优先做精确实体键，不能拿整句 terms[0] 去等值比较。
    q0 = next((x for x in tl if x.isdigit() or "." in x), tl[0] if tl else terms[0])
    err_rows = load_jsonl("graph/errcode.jsonl")
    hits = [r for r in err_rows if r["error_code"].lower() == q0.lower()]
    if not hits and q0.isdigit():
        hits = [r for r in err_rows if r.get("http_code") == q0]
    if not hits:
        hits = [r for r in err_rows if all(
            t.lower() in (r["error_code"] + " " + r["message"] + " " + r.get("explanation", "")).lower() for t in terms)]
    ent_counts["err"] = len(hits)
    for r in hits[:4]:
        ent_lines.append(f"[err] {r['error_code']} · {r['message']} · HTTP {r['http_code']}\n      {r.get('explanation','')[:80]} · {r['source_url']}")
    ev = [r for r in load_jsonl("graph/event.jsonl")
          if all(t in (r["title"] + " " + " ".join(r.get("event_types", []))).lower() for t in tl)]
    ent_counts["event"] = len(ev)
    for r in ev[:4]:
        tag = " ⚠归档" if r.get("archived") else ""
        ent_lines.append(f"[event] {r['title']}{tag} · {', '.join(r.get('event_types', [])[:4])}\n      {r['doc_path']} · {r['source_url']}")
        ent_paths.append(r["doc_path"])
    js = [r for r in load_jsonl("graph/jsapi.jsonl")
          if all(t in (r["title"] + " " + " ".join(r.get("jsapi_names", []))).lower() for t in tl)]
    js.sort(key=lambda r: (r.get("archived", False), len(r.get("jsapi_names", [])), r["doc_path"]))
    ent_counts["jsapi"] = len(js)
    for r in js[:4]:
        tag = " ⚠归档" if r.get("archived") else ""
        ent_lines.append(f"[jsapi] {r['title']}{tag} · 含: {', '.join(r.get('jsapi_names', [])[:4])}\n      {r['doc_path']} · {r['source_url']}")
        ent_paths.append(r["doc_path"])
    pm_rows = load_jsonl("graph/permission.jsonl")
    pm = [r for r in pm_rows if r["permission_scope"].lower() == q0.lower()] or \
         [r for r in pm_rows if q0.lower() in r["permission_scope"].lower()]
    ent_counts["perm"] = len(pm)
    for r in pm[:3]:
        apis = r.get("current_apis") or []
        hint = f" · 如 {apis[0]['title']} {apis[0]['doc_path']}" if apis else ""
        ent_lines.append(f"[perm] {r['permission_scope']} · 覆盖 {r['api_count']} 个接口{hint}")

    # 2) find 篇目（排序逻辑与 cmd_find 一致；跨阶段题额外核对连接平台正文）
    stage_concepts = []
    if intent["stage"]:
        for concept, weight in (("鉴权请求参数", 100), ("执行动作", 100),
                                ("入参映射", 70), ("映射", 50), ("鉴权", 30), ("参数", 10)):
            if concept in raw_q:
                stage_concepts.append((concept, weight))
    scored, doc_nhit = [], {}
    term_hits = term_doc_hits(tl, docs)
    # 词权重按 IDF：「小程序」出现在几百篇里，「导航栏」只在十几篇，二者不能同权
    # （实录 Q139：泛词堆叠让通用教程页压过「设置导航栏」JSAPI 页）。与 dwsdoc 同口径。
    hays = []
    for d in docs:
        title = d["title"].lower()
        crumb = " ".join(d.get("breadcrumb") or []).lower()
        rest = (" ".join(d.get("headings") or []) + " " + d.get("snippet", "") + " "
                + d.get("slug", "") + " " + os.path.basename(d["local_path"])).lower()
        hays.append((title, crumb, " ".join((title, crumb, rest))))
    import math
    n_docs = len(docs) or 1
    tw = {}
    for w in tl:
        df = sum(1 for _, _, h in hays if w in h)
        idf = math.log((n_docs + 1) / (df + 1))
        tw[w] = 10 * min(2.5, max(0.4, idf / 2.0))
    for d, (title, crumb, hay) in zip(docs, hays):
        stage_body = ""
        if stage_concepts and d["local_path"].startswith("docs/02-连接平台/"):
            try:
                stage_body = open(os.path.join(ROOT, d["local_path"]), encoding="utf-8", errors="ignore").read().lower()
            except OSError:
                stage_body = ""
        nhit = sum(1 for w in tl if w in hay)
        tscore = term_hits.get(d["local_path"], 0)
        if nhit == 0 and not tscore:
            continue
        # AND 太严(自然问句拆词很难同时命中一篇),改为 OR + 命中词数优先。
        # 枚举题优先汇总/配置页，降权单事件叶子页，避免“有哪些事件”只返回某一个监听 API。
        # 正文标识符命中（cardData/downloadCode/navigateTo…）与标题命中同量级叠加。
        score = (sum(tw[w] for w in tl if w in hay) + sum(tw[w] for w in tl if w in title)
                 + sum(2 for w in tl if w in crumb) + tscore)
        if tscore:
            nhit += 1
        if doc_hint and d["local_path"] == doc_hint["local_path"]:
            score += 10000
        if stage_concepts:
            if "连接平台" in crumb:
                score += 20
            stage_text = stage_body or hay
            for concept, weight in stage_concepts:
                if concept in stage_text:
                    score += weight
                if concept in title:
                    score += weight // 2
            if "鉴权" in raw_q and "获取" in raw_q and "参数" in raw_q \
                    and any(k in stage_body for k in ("$.body", "$.header")):
                score += 120
            # 通用流程题不让官方模板/三方教程凭共享标题抢走基础参考文档；点名模板时不降权。
            title_terms = re.findall(r"[a-z0-9]+|[一-鿿]{2,}", title)
            named = any(t in raw_q for t in title_terms if len(t) >= 2)
            if any(k in crumb for k in ("官方模板鉴权", "三方连接器")) and not named:
                score -= 80
        if intent["cross_doc"]:
            if any(k in title for k in ("配置", "概述", "总览", "说明", "列表", "事件类型")):
                score += 30
            if any(title.startswith(k) for k in ("监听", "取消", "创建", "删除", "获取单个")):
                score -= 8
        if d["local_path"] in flags and not intent["version"]:
            score -= 100
        tier_rank = 1 if d["local_path"] in flags else 0
        doc_nhit[d["local_path"]] = nhit
        scored.append((-score, tier_rank, d["local_path"], d))
    scored.sort()
    ranked_docs = [d for _, _, _, d in scored]
    # 归档降权只为防旧版顶掉同主题现行版；但当问题的某个实体词（域限定词，如
    # 「小程序」）在现行区 top 候选的标题/面包屑里整体缺席、只有归档篇覆盖时，
    # 埋掉归档篇=换域强答（实录 Q147：小程序 Page 事件被事件订阅文档顶掉）。
    # 此时把最强归档篇提回首位，⚠归档 标签保留，由模型按归档纪律声明时效。
    if scored and not intent["version"] and len(tl) >= 2:
        _tc = lambda d: (d["title"] + " " + " ".join(d.get("breadcrumb") or [])).lower()
        act_top = [d for _, t, _, d in scored if t == 0][:8]
        best_active_score = next((-s for s, t, _, _ in scored if t == 0), 0)
        lost = [w for w in tl if len(w) >= 2 and not any(w in _tc(d) for d in act_top)]
        arch_entry = next(((-s + 100, d) for s, t, _, d in scored
                           if t == 1 and any(w in _tc(d) for w in lost)), None) if lost else None
        if arch_entry and arch_entry[0] >= best_active_score:
            ranked_docs.remove(arch_entry[1])
            ranked_docs.insert(0, arch_entry[1])
            scored.insert(0, (-(arch_entry[0]), 0, arch_entry[1]["local_path"], arch_entry[1]))
    stage_reps = []
    if intent["stage"]:
        if "执行动作" in raw_q:
            execution = [d for d in ranked_docs if "执行动作" in d["title"]]
            if "映射" in raw_q or "参数" in raw_q:
                execution.sort(key=lambda d: (not any(k in d["title"] for k in ("入参", "映射")),
                                              ranked_docs.index(d)))
            if execution:
                stage_reps.append(execution[0])
        if "鉴权" in raw_q:
            auth = [d for d in ranked_docs if "鉴权" in d["title"] and d["local_path"] not in flags]
            if auth:
                stage_reps.append(auth[0])
    flow_reps = []
    auth_flow = intent["semantic"] and not intent["stage"] and any(
        k in raw_q for k in ("免登", "oauth", "鉴权", "登录"))
    if auth_flow:
        active_docs = [d for d in ranked_docs if d["local_path"] not in flags]
        if active_docs:
            flow_reps.append(active_docs[0])
        token_doc = next((d for d in active_docs if any(k in d["title"].lower()
                                                        for k in ("token", "access", "凭证"))), None)
        identity_doc = next((d for d in active_docs if any(k in d["title"]
                                                           for k in ("用户信息", "身份信息", "用户身份"))), None)
        if token_doc:
            flow_reps.append(token_doc)
        if identity_doc:
            flow_reps.append(identity_doc)
    # 「XX 权限怎么开通/申请」的操作路径在通用指南「添加接口调用权限」里；
    # 权限点实体命中只证明权限存在，答不出开通入口，须机械补入该篇（slug 定位，非猜测）。
    if "权限" in raw_q and any(k in raw_q for k in ("开通", "申请", "添加", "获取", "授权", "配置")):
        perm_guide = next((d for d in docs if d.get("slug") == "add-api-permission"), None)
        if perm_guide and perm_guide not in flow_reps:
            flow_reps.append(perm_guide)

    # 3) 候选合并：显式 source_url 永远第一；流程题先覆盖教程、凭证和身份等阶段，再补相关正文。
    cand, seen = [], set()
    def add_doc(d):
        if d and d["local_path"] not in seen:
            cand.append(d)
            seen.add(d["local_path"])
    add_doc(doc_hint)
    for d in stage_reps:
        add_doc(d)
    for d in flow_reps:
        add_doc(d)
    if guide_query or intent["cross_doc"] or intent["enumeration"]:
        for _, _, _, d in scored:
            add_doc(d)
        for p in ent_paths:
            add_doc(bymap.get(p))
    else:
        for p in ent_paths:
            add_doc(bymap.get(p))
        for _, _, _, d in scored:
            add_doc(d)

    edges = load_jsonl("graph/links.jsonl") if cand else []

    # API 卡片只在“未归档 + full + 首名明显胜出 + 非复杂问法”时替代正文。
    cards_enabled = (not force_full and os.environ.get("KB_NO_CARDS") != "1")
    api_top = rows[0] if rows else None
    api_card = read_api_card(api_top["doc_path"]) if cards_enabled and api_top else None
    top_score = api_top.get("_ctx_score", 0) if api_top else 0
    # 归档旧版与现行同标题同分时不算竞争者；现行版已由 archived 排序明确胜出。
    second_score = next((r.get("_ctx_score", 0) for r in rows[1:]
                         if bool(r.get("archived")) == bool(api_top.get("archived"))), 0) if api_top else 0
    confident = top_score >= 1000 or (top_score >= 14 and (not second_score or top_score >= second_score * 1.2))
    top_hay = _hay_api(api_top) if api_top else ""
    strong_anchor = top_score >= 1000 or any(
        w in top_hay and ((re.fullmatch(r"[一-鿿]+", w) and len(w) >= 4)
                          or (re.fullmatch(r"[a-z0-9_.:/-]+", w) and len(w) >= 6))
        for w in api_terms)
    card_scope = (top_score >= 1000 or any(k in raw_q for k in
                  ("接口地址", "文档地址", "endpoint", "http method", "请求方式", "请求方法",
                   "请求头", "请求体", "查询参数", "路径参数", "参数", "字段", "必填",
                   "返回值", "返回字段", "响应", "权限点", "调用", "用法", "示例")))
    card_blocked = any(intent.values())
    card_fast = bool(api_card and api_card["full"] and not api_card.get("archived")
                     and confident and strong_anchor and card_scope and not card_blocked)
    # 审计必须能区分「意图阻断」与「人为关卡」：--full/KB_NO_CARDS 下 card=0 却报
    # blocked=none 会被误读成"本可 fast 而未 fast"。
    blocked_reasons = [k for k, v in intent.items() if v]
    if force_full:
        blocked_reasons.append("forced_full")
    elif os.environ.get("KB_NO_CARDS") == "1":
        blocked_reasons.append("cards_disabled")
    blocked_audit = ",".join(blocked_reasons) or "none"

    def render(top_k):
        parts = []
        if card_fast:
            parts.append("== API答案卡(card:full,首名明确,可直接作答) ==")
            parts.append(api_card["body"])
        parts.append(_evidence_contract(api_card, intent, card_fast))
        if ent_lines:
            parts.append("== 实体命中 ==")
            parts.extend(ent_lines)
        for i, d in enumerate(cand[:top_k]):
            lp = d["local_path"]
            tag = " " + flags.get(lp, "") if flags.get(lp) else ""
            parts.append(f"\n== 正文[{i+1}/{min(top_k, len(cand))}] {d['title']}{tag} ({lp}) ==")
            parts.append(f"source_url: {d['source_url']} · updated_at: {d['updated_at'][:10]}")
            body = open(os.path.join(ROOT, lp), encoding="utf-8", errors="ignore").read()
            if len(body) > _CTX_BODY_CAP:
                body = body[:_CTX_BODY_CAP] + f"\n…[已截断，完整: dkdoc cat {lp}]"
            parts.append(body)
            out_e = [e for e in edges if e["from"] == lp][:6]
            inc_e = [e for e in edges if e["to"] == lp][:6]
            if out_e or inc_e:
                parts.append("== 相邻篇(links) ==")
                # 支持性/存在性问法：正确答案常在相邻篇（如「创建公告」→「公告钉盘空间」），
                # 只给标题会逼出第二轮 cat，故直接带摘要，一轮到位。
                # 相邻篇摘要只挂在首篇：三篇正文各带 3×800 字摘要曾让流程题上下文
                # 膨胀到 19K（R10.2.1 实录 Q59），摘要本身是第二轮 cat 的替代品，首篇足够。
                brief = (intent["support"] or intent["why"]) and i == 0
                shown = 0
                for e in out_e + inc_e:
                    tgt = e["to"] if e in out_e else e["from"]
                    arrow = "→" if e in out_e else "←"
                    if brief and shown < 3 and tgt in bymap:
                        try:
                            b = open(os.path.join(ROOT, tgt), encoding="utf-8", errors="ignore").read()
                        except OSError:
                            b = ""
                        head = b[:500].replace("\n\n", "\n")
                        parts.append(f"  {arrow} {tgt} — {bymap[tgt]['title']}")
                        parts.append(f"    摘要: {head}")
                        shown += 1
                    else:
                        parts.append(f"  {arrow} {tgt}")
        others = cand[top_k:top_k + 8]
        if others:
            parts.append("\n== 其他候选(未展开) ==")
            for d in others:
                tag = " " + flags.get(d["local_path"], "") if flags.get(d["local_path"]) else ""
                parts.append(f"  {d['title']}{tag} — {d['local_path']}")
        if intent["howmany"] and cand:
            lim = []
            for d in cand[:3]:
                try:
                    b = open(os.path.join(ROOT, d["local_path"]), encoding="utf-8", errors="ignore").read()
                except OSError:
                    continue
                for l in _limit_lines(b, 6):
                    lim.append(f"  [{d['title'][:20]}] {l[:120]}")
            if lim:
                parts.append("\n== 数值/限额专项(问法含数量或时长时自动抽取) ==")
                parts.extend(lim[:15])
        parts.append("\n== 检索审计 ==")
        parts.append("已检索: card/api/err/event/jsapi/perm/find · 关键词: " + " ".join(terms)
                     + f" · 命中: card={int(bool(api_card))}(fast={int(card_fast)}) "
                     + " ".join(f"{k}={v}" for k, v in ent_counts.items())
                     + f" find={len(scored)} · card_blocked={blocked_audit}")
        parts.append("== 继续 ==")
        tips = ["读候选: dkdoc cat <路径>", "深查: dkdoc links <路径>", "全文兜底: dkdoc grep '<词>'"]
        if card_fast:
            tips.insert(0, "API卡为full且首名明确:字段齐全可直接作答,无需cat")
        if intent["support"]:
            tips.append("否定前必看: meta/UNAVAILABLE.md(抓取盲区)+上方相邻篇摘要")
        if intent["error"]:
            tips.append("错误码语义: dkdoc err <码>")
        parts.append(" · ".join(tips))
        return "\n".join(parts)

    # 简单实体题只带一篇；流程/跨阶段/汇总题需同时展开 2-3 篇，避免单 API 片段冒充完整流程。
    ent_total = sum(ent_counts.values())
    # 正文标识符命中(cardData/downloadCode…)本质是实体题：不收紧会两篇各 8000 撑到 19K。
    if term_hits and not ent_total:
        ent_total = 1
    global _CTX_BODY_CAP
    multi_doc = intent["stage"] or intent["semantic"] or intent["cross_doc"] or intent["enumeration"]
    top_k_default = 3 if multi_doc else (1 if ent_total >= 1 else 2)
    if ent_total >= 1 or multi_doc:
        # 多篇题每篇 3500：R10.2.1 实录 3 篇×5000 使 Q24/Q59 上下文 19K、正文时延 70–100s；
        # 本地验证 3500 仍保留 ssoUserInfo/x-acs 头/执行动作/onLoad 等关键证据。
        _CTX_BODY_CAP = 3500 if multi_doc else 5000

    if not cand and not ent_lines:
        print(_evidence_contract(None, intent, False))
        print("== 检索审计 ==")
        print("已检索: api/err/event/jsapi/perm/find · 关键词: " + " ".join(terms)
              + f" · 命中: 0 · card_blocked={blocked_audit}")
        print("== 继续 ==")
        print(f"换同义词重试 ctx；或 dkdoc grep '{' '.join(terms)}'；否定前核对 meta/UNAVAILABLE.md")
        return 1
    text = render(0 if card_fast else top_k_default)
    # 超限时先压单篇正文，再降篇数；流程/跨阶段题保底 2 篇——降到 1 篇会丢配置阶段，
    # 拿单篇冒充完整流程（实录 Q75：正确的执行动作/鉴权文档被挤出正文位）。
    if len(text) > _CTX_TOTAL_CAP and not card_fast:
        _CTX_BODY_CAP = 3000
        text = render(top_k_default)
    if len(text) > _CTX_TOTAL_CAP and not card_fast:
        text = render(2 if multi_doc else 1)
    if len(text) > _CTX_TOTAL_CAP:
        text = text[:_CTX_TOTAL_CAP] + "\n…[ctx 总量截断，用 dkdoc cat 读完整正文]"
    print(text)
    return 0


def usage(msg=""):
    if msg:
        print("错误: " + msg + "\n", file=sys.stderr)
    print(__doc__.strip())
    return 2


def main():
    argv = sys.argv[1:]
    n = 10
    if "-n" in argv:
        i = argv.index("-n")
        try:
            n = int(argv[i + 1])
            del argv[i:i + 2]
        except (IndexError, ValueError):
            return usage("-n 需要整数")
    if not argv:
        return usage()
    cmd, terms = argv[0], argv[1:]
    force_full = False
    if cmd == "ctx" and "--full" in terms:
        terms = [x for x in terms if x != "--full"]
        force_full = True
    # ctx 调用方可能传多参数(ctx a b c)或引号整串(ctx "a b c"),后者不拆词会让
    # 逐词检索退化成整句子串匹配而全部落空(实录:整串222B/0命中 vs 多参数14KB)。
    if cmd == "ctx" and len(terms) == 1:
        terms = [w for w in re.split(r"[\s,，、]+", terms[0]) if w] or terms
    if cmd == "ctx":
        return cmd_ctx(terms, n, force_full=force_full)
    if cmd == "where":
        print(ROOT)
        return 0
    table = {"find": cmd_find, "api": cmd_api, "err": cmd_err, "event": cmd_event,
             "jsapi": cmd_jsapi, "perm": cmd_perm, "links": cmd_links, "cat": cmd_cat,
             "grep": cmd_grep, "card": cmd_card}
    if cmd not in table:
        return usage(f"未知子命令 {cmd}")
    return table[cmd](terms, n)


if __name__ == "__main__":
    sys.exit(main())
